digraph formal_methodology {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=12, nodesep=0.35, ranksep=0.45, label="Formal Methodology Decision Tree (per feature)", labelloc=t];
  node [fontname="Helvetica", fontsize=11, style="filled,rounded", shape=box];
  edge [fontname="Helvetica", fontsize=10];
  S   [label="New IP spec", fillcolor="#d9d9d9"];
  R   [label="Step 1: full spec read\nspec_inventory.md (cited §)", fillcolor="#d9d9d9"];
  C   [label="Step 2: classify feature\nC1-C10 + tags S/P/Y", fillcolor="#d9d9d9"];
  Q0  [label="Q0  Digital and checkable\nat RTL from spec?", shape=diamond, style=filled, fillcolor="#fff2cc"];
  Q1  [label="Q1  Purely\ncombinational? (C1)", shape=diamond, style=filled, fillcolor="#fff2cc"];
  Q2  [label="Q2  Register map\nto sign off? (C2)", shape=diamond, style=filled, fillcolor="#fff2cc"];
  Q3  [label="Q3  Interconnect NxM\n+ arbitration? (C5)", shape=diamond, style=filled, fillcolor="#fff2cc"];
  Q4  [label="Q4  End-to-end\ndata integrity? (C4)", shape=diamond, style=filled, fillcolor="#fff2cc"];
  Q5  [label="Q5  Control / FSM /\ntimers / interrupts? (C3)", shape=diamond, style=filled, fillcolor="#fff2cc"];
  Q6  [label="Q6  Overlay-only\nfeature?", shape=diamond, style=filled, fillcolor="#fff2cc"];
  OOS [label="D-OOS\nout of scope (record)", fillcolor="#f4cccc"];
  SIM [label="D-SIM\nsimulation / hybrid\n(reason from spec)", fillcolor="#f4cccc"];
  GAP [label="SPEC GAP\nspec_gaps.md, ask user", fillcolor="#f4cccc"];
  CONN [label="D-CONN\nformal-connectivity", fillcolor="#d9ead3"];
  CSR  [label="D-CSR\nformal-csr", fillcolor="#d9ead3"];
  F3   [label="D-FPV3\nformal-fpv Path 3\nABVIP + per-initiator SB + SVA", fillcolor="#d9ead3"];
  F2   [label="D-FPV2\nformal-fpv Path 2\nwrapper + models + SB + SVA", fillcolor="#d9ead3"];
  F1   [label="D-FPV1\nformal-fpv Path 1\nbind-file SVA", fillcolor="#d9ead3"];
  OV   [label="OVERLAYS (every feature)\nC6 X-sensitive → D-XPROP (formal-xprop)\nC7 equivalence → D-SEC*   C8 async clocks → D-CDC*\nC9 unreachability → D-UNR*   S → D-FSV*   P → D-LPV*\nY → D-SPV*   optional → D-SLINT*\n(* manual, no skill yet)", fillcolor="#cfe2f3"];
  G    [label="Complexity gate\n(complexity_rubric.md)", shape=diamond, style=filled, fillcolor="#fff2cc"];
  K    [label="Keep outcome", fillcolor="#d9ead3"];
  H    [label="Keep + abstraction plan\nhybrid candidate", fillcolor="#fce5cd"];
  REP  [label="Step 5: <ip>_formal_methodology.md\nStep 6: user approval", fillcolor="#d9d9d9"];
  RUN  [label="RUN ORDER\n0 D-SLINT (opt) → 1 formal-connectivity → 2 formal-csr\n→ 3 formal-fpv → 4 formal-xprop → 5 manual apps (SEC, CDC, FSV, LPV, SPV, UNR)\n→ 6 formal-traceability → 7 formal-vplan (NOW/LATER/NO)\n→ 8 param-spec-audit (always last)", fillcolor="#ead1dc"];
  S -> R -> C -> Q0;
  Q0 -> OOS [label="analog / timing / DFT"];
  Q0 -> SIM [label="SW/FW sequence"];
  Q0 -> Q1 [label="yes"];
  Q1 -> CONN [label="yes"];
  Q1 -> Q2 [label="no"];
  Q2 -> CSR [label="yes"];
  Q2 -> Q3 [label="no"];
  CSR -> Q3 [style=dashed, label="field function"];
  Q3 -> F3 [label="yes"];
  Q3 -> Q4 [label="no"];
  Q4 -> F2 [label="yes"];
  Q4 -> Q5 [label="no"];
  Q5 -> F1 [label="yes"];
  Q5 -> Q6 [label="no"];
  Q6 -> OV [label="yes"];
  Q6 -> GAP [label="no"];
  CONN -> OV; F3 -> OV; F2 -> OV; F1 -> OV;
  OV -> G;
  G -> K [label="LOW / MED"];
  G -> H [label="HIGH"];
  G -> SIM [label="VERY HIGH"];
  K -> REP; H -> REP;
  REP -> RUN;
}
